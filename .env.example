# Application environment (dev, test, prod)
APP_ENV=dev

# Debug mode
DEBUG=false

# SQLite database file URL
DATABASE_URL=sqlite:///./var/app.db

# Recruiter default IANA timezone
APP_DEFAULT_TZ=Asia/Kolkata

# Job title displayed in header
JOB_TITLE=Senior Backend Engineer

# Gemini API Key (leave blank to disable LLM fallback)
GEMINI_API_KEY=

# Gemini model identifier
GEMINI_MODEL=gemini-2.5-flash

# LLM call timeout in seconds
LLM_TIMEOUT_S=4.0

# Thinking budget for LLM output (0 for minimal/disabled)
LLM_THINKING_BUDGET=0

# Rate limit for LLM calls per minute
LLM_MAX_CALLS_PER_MIN=30

# Enable raw query logging in telemetry (names are PII)
TELEMETRY_LOG_QUERIES=false

# Telemetry file output path
TELEMETRY_PATH=var/telemetry.jsonl
